{
  "api": {
    "url": "https://your-ocr-service.example.com",
    "gate": "1",
    "timeout_seconds": 30,
    "max_retries": 3,
    "token_refresh_interval_hours": 12
  },
  "detection": {
    "threshold_container": 0.4,
    "threshold_text": 0.2,
    "iou_threshold": 0.7,
    "imgsz_tracking": 480,
    "imgsz_text_detection": 480,
    "frame_sample_interval_seconds": 0.5,
    "model_path": "container-detection-drone-view/weight/container_detection_model.onnx"
  },
  "stitching": {
    "pipeline_script": "container-detection-drone-view/pipeline_yolo_paronama.py",
    "profile": "fast",
    "min_crops_per_track": 25,
    "device": "auto"
  },
  "paths": {
    "output_dir": "outputs",
    "data_dir": "data",
    "logs_dir": "logs"
  },
  "app": {
    "auto_resume_interrupted": true,
    "max_parallel_ocr_requests": 4,
    "video_resolution": "720P"
  }
}
