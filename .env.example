# Optional runtime environment overrides (do NOT place real secrets here).
# Non-secret API URL and gate settings live in config/config.json (copied from config/config.example.json).
# Authentication tokens are stored encrypted via Windows DPAPI in data/.token.dpapi.

# Disable Ultralytics automatic pip checks/installs at startup (set automatically in main.py)
ULTRALYTICS_SKIP_REQUIREMENTS_CHECKS=1
YOLO_AUTOINSTALL=0

# Optional Qt platform plugin override for headless CI testing (e.g., offscreen)
# QT_QPA_PLATFORM=offscreen

# Optional OCR API overrides (takes precedence over config/config.json)
# OCR_API_URL=https://your-ocr-service.example.com
# OCR_API_GATE=1
